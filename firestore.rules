rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'none') 
        : 'none';
    }

    function hasAnyRole(roles) {
      return getUserRole() in roles;
    }

    function isAdmin() {
      let tokenEmail = (request.auth != null && ('email' in request.auth.token) && (request.auth.token.email is string)) ? request.auth.token.email.toLower() : '';
      let userDoc = (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
      let docEmail = userDoc.get('email', '').toLower();
      let docRole = userDoc.get('role', 'none');
      let uid = request.auth != null ? request.auth.uid : '';
      
      return isAuthenticated() &&
        (
          (tokenEmail in [
            "asmatn628@gmail.com",
            "asmatullah9327@gmail.com",
            "kabirahmaddev@gmail.com",
            "wamoviesstation@gmail.com"
          ]) ||
          (docEmail in [
            "asmatn628@gmail.com",
            "asmatullah9327@gmail.com",
            "kabirahmaddev@gmail.com",
            "wamoviesstation@gmail.com"
          ]) ||
          (uid in ["fbG4L3d6gMPVcCcDwWUqbAEGs7E2", "2CvmzHixVQbqdZXycFyvfBxiTkJ3"]) ||
          docRole in ['admin', 'owner']
        );
    }

    function isContentManager() {
      return hasAnyRole(['content_manager']);
    }

    function isUserManager() {
      return hasAnyRole(['user_manager']);
    }

    function isManager() {
      return hasAnyRole(['manager']);
    }

    function isEditor() {
      return hasAnyRole(['editor']);
    }

    function isAdminOrEditor() {
      return isAdmin() || hasAnyRole(['content_manager', 'manager', 'editor', 'user_manager']);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    function isValidUser(data) {
      let email = data.get('email', null);
      let phone = data.get('phone', null);
      let name = data.get('displayName', null);
      let refCode = data.get('referralCode', null);
      
      let emailValid = email == null || (email is string && email.size() < 150);
      let phoneValid = phone == null || (phone is string && phone.size() < 50);
      let nameValid = name == null || (name is string && name.size() < 200);
      let refCodeValid = refCode == null || (refCode is string && refCode.size() < 50);
      
      // Only validate 'role' and 'status' if they exist in the update payload
      let roleValid = !('role' in data) || (data.role in ['admin', 'owner', 'manager', 'user_manager', 'content_manager', 'user', 'trial', 'selected_content', 'editor', 'temporary']);
      let statusValid = !('status' in data) || (data.status in ['active', 'pending', 'suspended', 'expired']);
      
      return emailValid && phoneValid && nameValid && roleValid && statusValid && refCodeValid;
    }

    function protectedUserFieldsUnchanged() {
      let d = request.resource.data;
      let r = resource.data;
      let statusIsExpired = d.get('status', '') == 'expired';
      // If a field is not present in the update, it is considered "unchanged" (i.e. we don't care if it's there or not, as long as it isn't being modified)
      return d.get('role', r.get('role', null)) == r.get('role', null) &&
             (d.get('status', r.get('status', null)) == r.get('status', null) || statusIsExpired) &&
             d.get('expiryDate', r.get('expiryDate', null)) == r.get('expiryDate', null) &&
             d.get('managedBy', r.get('managedBy', null)) == r.get('managedBy', null) &&
             d.get('permissions', r.get('permissions', null)) == r.get('permissions', null) &&
             d.get('assignedContent', r.get('assignedContent', null)) == r.get('assignedContent', null);
    }

    function isPendingOwner(userId, resourceData) {
      return isAuthenticated() && 
             (userId.startsWith('pending_') || userId == request.auth.uid) &&
             (
               isIdentityMatch(resourceData) ||
               (userId == 'pending_' + request.auth.token.get('phone_number', 'invalid')) ||
               (userId == 'pending_' + request.auth.uid)
             );
    }

    function isTrialActivation(userId) {
      let d = request.resource.data;
      let r = resource.data;
      
      // Mandatory: Already have 'User' role, 'Pending' status, NOT yet activated trial
      let isEligible = r.get('role', 'none') == 'user' && 
                       r.get('status', 'none') == 'pending' &&
                       r.get('trialActivated', false) == false;
      
      // Required changes: Role -> Trial, Status -> Active, trialActivated -> true, expiryDate -> string
      let roleValid = d.get('role', '') == 'trial';
      let statusValid = d.get('status', '') == 'active';
      let activationValid = d.get('trialActivated', false) == true;
      let expiryValid = d.get('expiryDate', '') is string && d.get('expiryDate', '').size() > 10;
      
      // Sensitive fields lock
      let sensitiveValid = !d.diff(r).affectedKeys().hasAny(['managedBy', 'permissions', 'assignedContent']);

      return isEligible && roleValid && statusValid && activationValid && expiryValid && sensitiveValid;
    }

    function isRewardClaim(userId) {
      let d = request.resource.data;
      let r = resource.data;
      
      let isClaiming = (d.get('pwaRewardClaimed', false) == true && r.get('pwaRewardClaimed', false) == false) ||
                       (d.get('notificationRewardClaimed', false) == true && r.get('notificationRewardClaimed', false) == false) ||
                       (d.get('reviewRewardClaimed', false) == true && r.get('reviewRewardClaimed', false) == false) ||
                       (d.get('claimedReferralSignups', []).size() > r.get('claimedReferralSignups', []).size()) ||
                       (d.get('claimedReferralActivations', []).size() > r.get('claimedReferralActivations', []).size()) ||
                       (d.get('signupRewardClaimed', false) == true && r.get('signupRewardClaimed', false) == false);
                       
      let statusValid = d.get('status', r.get('status', 'none')) in ['active', 'pending', 'suspended', 'expired'];
      
      let sensitiveValid = !d.diff(r).affectedKeys().hasAny(['role', 'trialActivated', 'managedBy', 'permissions', 'assignedContent']);

      return isClaiming && statusValid && sensitiveValid;
    }

    function isIdentityMatch(resourceData) {
      let dbPhone = resourceData.get('phone', '');
      let dbEmail = resourceData.get('email', '').toLower();
      let tokenPhone = request.auth != null && ('phone_number' in request.auth.token) ? request.auth.token.phone_number : '';
      let tokenEmail = request.auth != null && ('email' in request.auth.token) && (request.auth.token.email is string) ? request.auth.token.email.toLower() : '';
      
      let userDoc = exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : {};
      let userDocPhone = userDoc.get('phone', '');
      let userDocEmail = userDoc.get('email', '').toLower();

      return isAuthenticated() && 
             (
               (dbEmail != '' && tokenEmail != '' && dbEmail == tokenEmail) || 
               (dbEmail != '' && userDocEmail != '' && dbEmail == userDocEmail) ||
               (dbPhone != '' && tokenPhone != '' && (
                 dbPhone == tokenPhone || 
                 '+92' + dbPhone == tokenPhone || 
                 dbPhone.replace('^0', '+92') == tokenPhone ||
                 '+' + dbPhone == tokenPhone ||
                 dbPhone.replace('^92', '+92') == tokenPhone
               )) ||
               (dbPhone != '' && userDocPhone != '' && (
                 dbPhone == userDocPhone ||
                 '+92' + dbPhone == userDocPhone ||
                 dbPhone == '+92' + userDocPhone ||
                 '0' + dbPhone == userDocPhone ||
                 dbPhone == '0' + userDocPhone
               )) ||
               (dbEmail != '' && userDocPhone != '' && dbEmail == userDocPhone + '@moviznow.com')
             );
    }

    match /referral/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /users/referral {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /users/referralcodes {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdminOrEditor() || isUserManager() || isManager() || (resource != null && (isIdentityMatch(resource.data) || resource.data.get('referredBy', '') == request.auth.uid));
      allow list: if isAdminOrEditor() || isUserManager() || isManager() || (request.query.limit <= 500);
      
      allow create: if isAdmin() || (isValidUser(request.resource.data) && (
                       isOwner(userId) ||
                       isPendingOwner(userId, request.resource.data) ||
                       isAdminOrEditor() ||
                       (isUserManager() && request.resource.data.get('managedBy', '') == request.auth.uid) ||
                       (isManager() && request.resource.data.get('managedBy', '') == request.auth.uid)
                    ));
      
      allow update: if isAdmin() ||
                       (isAdminOrEditor() && isValidUser(request.resource.data)) ||
                       ((isOwner(userId) || (resource != null && isIdentityMatch(resource.data))) && isValidUser(request.resource.data) && 
                        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'expiryDate', 'trialActivated', 'managedBy', 'permissions', 'assignedContent'])
                        || protectedUserFieldsUnchanged() || isTrialActivation(userId) || isRewardClaim(userId))) ||
                       ((isUserManager() || isManager()) && resource.data.get('managedBy', null) == request.auth.uid && request.resource.data.get('managedBy', null) == request.auth.uid && isValidUser(request.resource.data));

      allow delete: if isAdmin() || isAdminOrEditor() || isPendingOwner(userId, resource.data) || isIdentityMatch(resource.data) || (isAuthenticated() && (userId.startsWith('pending_') || userId == request.auth.uid));
    }

    match /genres/{genreId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /languages/{languageId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /content_meta/versions/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /qualities/{qualityId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /content/{contentId} {
      // Allow read for all authenticated users, or for unauthenticated users if content is published
      allow read: if isAuthenticated() || resource.data.status == 'published';
      
      // Allow admins/editors to create anything.
      // Allow unauthenticated (other app) to create ONLY drafts with strict validation.
      allow create: if isAdminOrEditor() || (
        request.resource.data.status == 'draft' &&
        request.resource.data.title is string && 
        request.resource.data.title.size() > 0 && 
        request.resource.data.title.size() < 200 &&
        (request.resource.data.type == 'movie' || request.resource.data.type == 'series')
      );
      
      // Allow admins/editors to update anything.
      // Allow unauthenticated (other app) to update ONLY if it stays a draft.
      allow update: if isAdminOrEditor() || (
        resource.data.status == 'draft' && 
        request.resource.data.status == 'draft' &&
        (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() < 200))
      );
      
      allow delete: if isAdminOrEditor();
    }

    match /metadata/{docId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /analytics/referral_stats {
      allow read: if isAdminOrEditor();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                    request.resource.data.diff(resource.data).affectedKeys().hasAny(['clicks_whatsapp', 'clicks_telegram', 'total_clicks', 'lastUpdated']);
    }

    match /analytics/{eventId} {
      allow read: if isAdmin() || isManager() || (isUserManager() && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.managedBy == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /income/{incomeId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrEditor();
    }

    match /notification_templates/{templateId} {
      allow read, write: if isAdminOrEditor();
    }

    match /test/{docId} {
      allow read, write: if isAdmin();
    }

    function isValidFCMToken(data) {
      return data.token is string && data.token.size() > 0 &&
             data.userId is string && data.userId.size() > 0 &&
             data.updatedAt is string;
    }

    match /fcm_tokens/{chunkId} {
      allow read, write: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /whitelisted_phones/{phoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /notification_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /collection_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /review_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /chunk_meta/{docId} {
      allow read, write: if true;
    }

    match /search_index_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
