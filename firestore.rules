rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) 
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : 'none';
    }

    function hasAnyRole(roles) {
      return getUserRole() in roles;
    }

    function isAdmin() {
      let email = ('email' in request.auth.token) ? request.auth.token.email.lower() : '';
      let uid = request.auth.uid;
      
      return isAuthenticated() &&
        (
          (email in [
            "asmatn628@gmail.com",
            "asmatullah9327@gmail.com",
            "kabirahmaddev@gmail.com",
            "wamoviesstation@gmail.com"
          ]) ||
          (uid in ["fbG4L3d6gMPVcCcDwWUqbAEGs7E2", "2CvmzHixVQbqdZXycFyvfBxiTkJ3"]) ||
          hasAnyRole(['admin', 'owner'])
        );
    }

    function isContentManager() {
      return hasAnyRole(['content_manager']);
    }

    function isUserManager() {
      return hasAnyRole(['user_manager']);
    }

    function isManager() {
      return hasAnyRole(['manager']);
    }

    function isEditor() {
      return hasAnyRole(['editor']);
    }

    function isAdminOrEditor() {
      return isAdmin() || hasAnyRole(['content_manager', 'manager', 'editor', 'user_manager']);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    function isValidUser(data) {
      let emailValid = !('email' in data) || data.email == null || (data.email is string && data.email.size() < 100);
      let phoneValid = !('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() < 50);
      let nameValid = !('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() < 100);
      let roleValid = data.get('role', 'user') in ['admin', 'owner', 'manager', 'user_manager', 'content_manager', 'user', 'trial', 'selected_content', 'editor', 'temporary'];
      let statusValid = data.get('status', 'active') in ['active', 'pending', 'suspended', 'expired'];
      
      return emailValid && phoneValid && nameValid && roleValid && statusValid;
    }

    function protectedUserFieldsUnchanged() {
      let d = request.resource.data;
      let r = resource.data;
      return d.get('role', 'user') == r.get('role', 'user') &&
             d.get('status', 'active') == r.get('status', 'active') &&
             d.get('expiryDate', null) == r.get('expiryDate', null) &&
             d.get('managedBy', null) == r.get('managedBy', null) &&
             d.get('permissions', null) == r.get('permissions', null) &&
             d.get('assignedContent', null) == r.get('assignedContent', null);
    }

    function isPendingOwner(userId, resourceData) {
      return isAuthenticated() && 
             userId.startsWith('pending_') && 
             (
               (resourceData.get('email', null) != null && ('email' in request.auth.token) && resourceData.email == request.auth.token.email) || 
               (resourceData.get('phone', null) != null && ('phone_number' in request.auth.token) && resourceData.phone == request.auth.token.phone_number)
             );
    }

    function isTrialActivation(userId) {
      let d = request.resource.data;
      let r = resource.data;
      return isOwner(userId) &&
             r.get('role', 'user') == 'user' &&
             r.get('status', 'pending') == 'pending' &&
             d.get('role', 'trial') == 'trial' &&
             d.get('status', 'active') == 'active' &&
             d.get('expiryDate', '') != '' &&
             timestamp(d.expiryDate) > request.time - duration.value(1, 'm') &&
             timestamp(d.expiryDate) <= request.time + duration.value(4, 'd') &&
             d.get('managedBy', null) == r.get('managedBy', null) &&
             d.get('permissions', null) == r.get('permissions', null) &&
             d.get('assignedContent', null) == r.get('assignedContent', null);
    }

    function isIdentityMatch(resourceData) {
      return isAuthenticated() && 
             (
               (resourceData.get('email', '') != '' && ('email' in request.auth.token) && resourceData.get('email', '').lower() == request.auth.token.email.lower()) || 
               (resourceData.get('phone', '') != '' && ('phone_number' in request.auth.token) && resourceData.get('phone', '') == request.auth.token.phone_number)
             );
    }

    match /users/{userId} {
      // 1. Owner Access: Read, Create, Update
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
                       (isAdmin() || request.resource.data.get('role', 'user') in ['user', 'trial', 'selected_content']);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) &&
                       (isAdmin() || protectedUserFieldsUnchanged() || isTrialActivation(userId));

      // 2. Admin/Manager/Identity Access
      allow get: if isAdminOrEditor() || isUserManager() || (resource != null && isIdentityMatch(resource.data));
      allow list: if (('limit' in request.query) && request.query.limit <= 10) || isAdminOrEditor() || isUserManager();
      allow create: if isAdmin() || (isValidUser(request.resource.data) && (
                       (isUserManager() && request.resource.data.managedBy == request.auth.uid && request.resource.data.role in ['user', 'trial', 'selected_content'] && request.resource.data.status != 'suspended') ||
                       (isAdminOrEditor() && request.resource.data.get('role', 'user') in ['user', 'trial', 'selected_content'])
                    ));
      allow update: if isAdmin() || (isValidUser(request.resource.data) && (
                       isTrialActivation(userId) ||
                       (isUserManager() && resource.data.managedBy == request.auth.uid && request.resource.data.managedBy == request.auth.uid && request.resource.data.role in ['user', 'trial', 'selected_content'] && request.resource.data.status != 'suspended') ||
                       (isAdminOrEditor() && (resource.data.role != 'admin' && resource.data.role != 'owner') && (request.resource.data.get('role', 'user') in ['user', 'trial', 'selected_content', 'content_manager', 'editor', 'manager', 'user_manager']))
                    ));
      allow delete: if isAdmin() || isAdminOrEditor() || isPendingOwner(userId, resource.data) || isIdentityMatch(resource.data);
    }

    match /genres/{genreId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /languages/{languageId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /qualities/{qualityId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /content/{contentId} {
      // Allow read for all authenticated users, or for unauthenticated users if content is published
      allow read: if isAuthenticated() || resource.data.status == 'published';
      
      // Allow admins/editors to create anything.
      // Allow unauthenticated (other app) to create ONLY drafts with strict validation.
      allow create: if isAdminOrEditor() || (
        request.resource.data.status == 'draft' &&
        request.resource.data.title is string && 
        request.resource.data.title.size() > 0 && 
        request.resource.data.title.size() < 200 &&
        (request.resource.data.type == 'movie' || request.resource.data.type == 'series')
      );
      
      // Allow admins/editors to update anything.
      // Allow unauthenticated (other app) to update ONLY if it stays a draft.
      allow update: if isAdminOrEditor() || (
        resource.data.status == 'draft' && 
        request.resource.data.status == 'draft' &&
        (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() < 200))
      );
      
      allow delete: if isAdminOrEditor();
    }

    match /metadata/{docId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /analytics/{eventId} {
      allow read: if isAdmin() || isManager() || (isUserManager() && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.managedBy == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /income/{incomeId} {
      allow read, write: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdminOrEditor();
    }

    match /notification_templates/{templateId} {
      allow read, write: if isAdminOrEditor();
    }

    match /test/{docId} {
      allow read, write: if isAdmin();
    }

    function isValidFCMToken(data) {
      return data.token is string && data.token.size() > 0 &&
             data.userId is string && data.userId.size() > 0 &&
             data.updatedAt is string;
    }

    match /fcm_tokens/{chunkId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() && 
                      exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    match /whitelisted_phones/{phoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /notification_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /collection_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /chunk_meta/{docId} {
      allow read: if true;
      allow write: if isAdminOrEditor() || (
        isAuthenticated() &&
        docId == 'versions' &&
        (
          // Allow creation of the versions document if it doesn't exist
          !exists(/databases/$(database)/documents/chunk_meta/versions) ||
          // Allow updating ONLY the current user's version entry in the 'users' map
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users']) &&
            request.resource.data.users.diff(resource.data.get('users', {})).affectedKeys().hasOnly([request.auth.uid])
          )
        )
      );
    }

    match /search_index_chunks/{chunkId} {
      allow read: if true;
      allow write: if isAdminOrEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
