{
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/movie/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!.*\\.(?:png|jpg|jpeg|gif|svg|ico|js|css|webmanifest|xml|json|txt)).*)",
      "destination": "/api/index.ts"
    }
  ]
}
